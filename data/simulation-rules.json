    "budgetUsed": "Σ effects.budget",
    "risk": "clamp(initial + Σ effects.risk, 0, 1)",
    "successScore": "round(100 * (0.35*(1-discount) + 0.25*reach + 0.20*credibility + 0.12*community + 0.08*tourism) - 12*max(0,budgetUsed-budgetCap) - 8*max(0,risk-0.25))",
    "predictedViewsM": "round(baselineViewsM * (0.35 + 0.65*reach) * (1.25 - discount))",
    "predictedAudience": "round(baselineAudience * (0.30 + 0.70*reach) * (1.20 - discount))",
    "predictedBoxOfficeUsdM": "round(baselineBoxOfficeUsdM * (0.25 + 0.75*tourism) * (1.15 - discount))",
    "predictedTourismCnyM": "round(baselineTourismCnyM * tourism)"
  },
