{
  "theories": [
    {"id":"cultural_discount","name":"文化折扣","english":"Cultural Discount","scholar":"Hoskins & Mirus (1988)","definition":"文化产品跨越文化边界时，因语言、风格、指涉对象与价值观差异导致价值贬损。","paperRef":"论文第二部分（二）（三）、第六部分（一）"},
    {"id":"high_low_context","name":"高语境 / 低语境文化","english":"High / Low Context Culture","scholar":"Edward T. Hall (1976)","definition":"高语境文化的意义高度依赖共享背景；进入低语境受众视野时更易发生解码损耗。","paperRef":"论文第五部分（三）"},
    {"id":"media_event","name":"媒介事件","english":"Media Event","scholar":"Dayan & Katz 传统；论文引用议程设置","definition":"权威媒介背书与直播式共享观看促成全民注意力，形成集体记忆点。","paperRef":"论文第四部分（一）"},
    {"id":"three_stage","name":"三阶段全球化路径","english":"Three-stage Globalization","scholar":"论文提炼","definition":"沿文化距离由近及远：东南亚深耕 → 欧美试水 → 全球扩张。","paperRef":"论文第五部分（一）表 1"},
    {"id":"localization","name":"本地化运营","english":"Localization Operations","scholar":"论文提炼","definition":"分市场、分平台的差异化编码与解码适配，包括语言、媒体、票务与演出协作。","paperRef":"论文第五部分（二）（五）"},
    {"id":"fan_economy","name":"粉丝社群经济","english":"Fan Community Economy","scholar":"论文提炼","definition":"将瞬时流量转化为有组织、高粘性的长期关系资产。","paperRef":"论文第四部分（三）"},
    {"id":"soft_power","name":"软实力","english":"Soft Power","scholar":"Joseph S. Nye","definition":"以吸引而非强制达成影响力，是跨文化传播的总纲。","paperRef":"论文第二部分（二）"},
    {"id":"city_brand","name":"城市品牌","english":"City Branding","scholar":"Kavaratzis (2004)","definition":"城市品牌应从营销传播上升为包含文化活动在内的整体沟通体系。","paperRef":"论文第二部分（二）、第四部分（二）"}
  ],
